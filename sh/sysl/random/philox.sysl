module sh.sysl.random
@no_alloc

/** Philox4x32 (J. K. Salmon, M. A. Moraes, R. O. Dror, D. E. Shaw, *Parallel Random Numbers: As Easy
 * as 1, 2, 3*, SC 2011; Random123's `philox.h`): a keyed bijection of a 128-bit counter, `ROUNDS`
 * rounds of two 32x32->64 multiplies. 10 rounds is the authors' recommended strength, and the value
 * the Random123 known-answer vectors pin; 7 is their fast variant.
 */
philox4x32[const ROUNDS: usize](counter: [4]u32, key: [2]u32) -> [4]u32
    var c = counter
    var k = key

    for r in 0..<ROUNDS
        if r > 0
            k[0] +%= 0x9e3779b9
            k[1] +%= 0xbb67ae85

        val p0 = u64(c[0]) * 0xd2511f53
        val p1 = u64(c[2]) * 0xcd9e8d57

        c = [u32(p1 >> 32) ^ c[1] ^ k[0], u32.wrap(p1), u32(p0 >> 32) ^ c[3] ^ k[1], u32.wrap(p0)]

    c
end philox4x32

/** Philox4x32 as a generator: **counter-based**, so the n-th output is a function of `(key, n)` and
 * nothing else. That is what a parallel program wants -- thread `t` can take key `t`, or every thread
 * the same key and its own range of counters, and no generator state crosses between them.
 *
 * Each block of four words gives two `u64`s, the earlier word low. The counter is 128 bits, carried
 * up from word 0 as Random123's `incr` carries it.
 */
struct Philox[const ROUNDS: usize]
    counter: [4]u32
    key: [2]u32
    buf: [2]u64
    at: usize

    /** A generator under a 64-bit key, counting from zero. */
    keyed(key: u64) -> Self = Philox[ROUNDS]([0; 4], [u32.wrap(key), u32(key >> 32)], [0; 2], 2)

    /** The `n`-th block's position: the generator jumps there, in one step, with no draws. */
    seek(*self, block: u128)
        for i in 0..<4
            self.counter[i] = u32.wrap(block >> (32 * u32(i)))

        self.at = 2

    /** The same counter under another key: an independent stream for another thread. */
    split(*self, key: u64) -> Self = Philox[ROUNDS](self.counter, [u32.wrap(key), u32(key >> 32)], [0; 2], 2)

    private refill(*self)
        val x = philox4x32[ROUNDS](self.counter, self.key)

        self.buf[0] = u64(x[0]) | u64(x[1]) << 32
        self.buf[1] = u64(x[2]) | u64(x[3]) << 32

        for i in 0..<4
            self.counter[i] +%= 1

            if self.counter[i] != 0 then break

        self.at = 0
end Philox

type Philox4x32 = Philox[10]

impl[const ROUNDS: usize] Rng for Philox[ROUNDS]
    next_u64(*self) -> u64
        if self.at == 2 then self.refill()

        val v = self.buf[self.at]

        self.at += 1
        v
